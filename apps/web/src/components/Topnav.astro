---
// Top navigation — lean by design (SK-WEB-031): the product routes stay
// top-level (Agents · Pricing · Docs); the editorial surfaces (Solve ·
// Compare · Blog · Manifesto) collapse behind one "Content" disclosure so
// the row routes a stranger to the product first. Both disclosures on
// this row (Content, and the authed avatar menu) share one APG
// disclosure implementation below: a toggle button revealing plain links
// — not `role="menu"` (that role obliges arrow-key focus management;
// links + Tab already work). Escape, outside-click and tab-away close.
//
// Auth-aware swap: `/api/auth/get-session` probes on every page load;
// when it resolves authed, "Sign in" hides and "Open chat" + an avatar
// button take its place (API keys / Billing / Sign out behind the avatar).
//
// Marketing-side caveat (`SK-WEB-009`): the probe returns null on
// `nlqdb.com` because the session cookie is host-only on
// `app.nlqdb.com` — authed visitors see the "Sign in" link.
import { appHref } from "../lib/app-href";

interface Props {
  current?:
    | "manifesto"
    | "agents"
    | "chat"
    | "keys"
    | "billing"
    | "vs"
    | "solve"
    | "blog"
    | "pricing";
}
const { current } = Astro.props;
const inChat = current === "chat";

// The Content group. Crawlable as plain `<a>`s in the HTML even while the
// panel is `hidden` — the SEO posture of `/solve`, `/vs`, `/blog`
// (SK-WEB-023) does not depend on the links being visible.
const CONTENT = [
  { key: "solve", href: "/solve/", label: "Solve", blurb: "One data question, one guide" },
  { key: "vs", href: "/vs/", label: "Compare", blurb: "Honest side-by-sides" },
  { key: "blog", href: "/blog/", label: "Blog", blurb: "Engineering notes" },
  { key: "manifesto", href: "/manifesto/", label: "Manifesto", blurb: "Why an autonomous DBA" },
] as const;
const inContent = CONTENT.some((c) => c.key === current);
---

<header class="topnav">
  <a class="topnav__brand" href="/">nlqdb</a>
  <nav class="topnav__links" aria-label="Primary">
    <a href="/agents/" aria-current={current === "agents" ? "page" : undefined}>Agents</a>
    <a href="/pricing/" aria-current={current === "pricing" ? "page" : undefined}>Pricing</a>
    <a href="https://docs.nlqdb.com/">Docs</a>

    <div class="topnav__menu" data-disclosure>
      <button
        type="button"
        class="topnav__menu-btn"
        aria-expanded="false"
        aria-controls="topnav-content-panel"
        data-current={inContent ? "true" : undefined}
        data-disclosure-btn
      >
        Content
        <svg
          class="topnav__chev"
          viewBox="0 0 12 12"
          width="11"
          height="11"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2 4l4 4 4-4"></path>
        </svg>
      </button>
      <div id="topnav-content-panel" class="topnav__panel" data-disclosure-panel hidden>
        {CONTENT.map((c) => (
          <a
            class="topnav__panel-item"
            href={c.href}
            aria-current={current === c.key ? "page" : undefined}
          >
            <span class="topnav__panel-label">{c.label}</span>
            <span class="topnav__panel-blurb">{c.blurb}</span>
          </a>
        ))}
      </div>
    </div>

    {/* Sign-in link — suppressed once the auth probe resolves authed. */}
    <span id="topnav-signin">
      <a href="/auth/sign-in/">Sign in</a>
    </span>

    {/* Authed slot — hidden by default; revealed only after the probe
        resolves authed. "Open chat" stays a top-level one-click link (the
        primary product action); the account chores collapse behind the
        avatar. Suppressed inside the chat itself (current === "chat"). */}
    <span id="topnav-authed" class="topnav__authed" hidden>
      {!inChat && (
        <a href={appHref("/app/")} class="topnav__chat-link">Open chat &rarr;</a>
      )}
      <div class="topnav__avatar-wrap" data-disclosure>
        <button
          type="button"
          id="topnav-avatar-btn"
          class="topnav__avatar"
          aria-expanded="false"
          aria-controls="topnav-avatar-panel"
          aria-label="Account menu"
          data-disclosure-btn
        >
          <span id="topnav-avatar-initial" aria-hidden="true">·</span>
        </button>
        <div id="topnav-avatar-panel" class="topnav__avatar-panel" data-disclosure-panel hidden>
          <a
            href={appHref("/app/keys/")}
            class="topnav__avatar-item"
            aria-current={current === "keys" ? "page" : undefined}
          >
            API keys
          </a>
          <a
            href={appHref("/app/billing/")}
            class="topnav__avatar-item"
            aria-current={current === "billing" ? "page" : undefined}
          >
            Billing
          </a>
          <button
            type="button"
            id="topnav-signout"
            class="topnav__avatar-item topnav__avatar-item--signout"
          >
            Sign out
          </button>
        </div>
      </div>
    </span>
  </nav>
</header>

<script>
  import { fetchSession } from "../lib/session";

  // The "Sign in" link stays a relative path on every origin. On the
  // marketing origin, `/auth/sign-in` itself hops to the merged app
  // worker (SK-AUTH-015 / SK-AUTH-016) carrying the visitor's draft /
  // pending prompt / anon token in the URL fragment (SK-ANON-015) —
  // a direct cross-origin href here would strand that localStorage
  // state on `nlqdb.com`.

  // ---- Disclosures (Content menu + avatar menu) ----------------------
  // One implementation for both. Click toggles; Escape closes and refocuses
  // the button when focus was inside; outside-click and tab-away close.
  // ArrowDown on the button opens and focuses the first item; Arrow keys
  // move between items; Escape from an item returns to the button. Pointer
  // hover opens/closes too (hover-capable devices only) so the Content menu
  // behaves like the dropdowns visitors expect on a marketing site.
  const hoverCapable = window.matchMedia("(hover: hover)").matches;

  function armDisclosure(wrap: HTMLElement) {
    const btn = wrap.querySelector<HTMLElement>("[data-disclosure-btn]");
    const panel = wrap.querySelector<HTMLElement>("[data-disclosure-panel]");
    if (!btn || !panel) return;
    const items = () => Array.from(panel.querySelectorAll<HTMLElement>("a, button"));

    // A mouse click arrives after pointerenter already opened the panel;
    // toggling would slam it shut on the very click meant to open it.
    let openedByHover = false;
    const set = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      if (!open) openedByHover = false;
    };
    const close = (refocus = false) => {
      if (panel.hidden) return;
      set(false);
      if (refocus) btn.focus();
    };

    btn.addEventListener("click", () => {
      if (panel.hidden) set(true);
      else if (openedByHover) openedByHover = false;
      else set(false);
    });
    btn.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      event.preventDefault();
      set(true);
      items()[0]?.focus();
    });
    panel.addEventListener("keydown", (event) => {
      const list = items();
      const i = list.indexOf(document.activeElement as HTMLElement);
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        const step = event.key === "ArrowDown" ? 1 : -1;
        list[(i + step + list.length) % list.length]?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (panel.hidden || wrap.contains(event.target as Node)) return;
      close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || panel.hidden) return;
      close(wrap.contains(document.activeElement));
    });
    // Tab-away: close once focus lands outside the wrap. Null
    // relatedTarget (plain clicks) is left to the outside-click
    // listener — closing here too would hide the panel between
    // mousedown and click in Safari and swallow item activation.
    wrap.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (panel.hidden || !next || wrap.contains(next)) return;
      close();
    });
    if (hoverCapable) {
      wrap.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse" || !panel.hidden) return;
        set(true);
        openedByHover = true;
      });
      wrap.addEventListener("pointerleave", (event) => {
        if (event.pointerType === "mouse") close();
      });
    }
  }

  document.querySelectorAll<HTMLElement>("[data-disclosure]").forEach(armDisclosure);

  // ---- Sign out --------------------------------------------------------
  // All sign-out triggers funnel through /auth/sign-out (SK-AUTH-019).
  document.getElementById("topnav-signout")?.addEventListener("click", () => {
    window.location.assign("/auth/sign-out/");
  });

  // ---- Auth-aware swap -------------------------------------------------
  void (async () => {
    const user = await fetchSession();
    if (!user) return;
    document.getElementById("topnav-authed")?.removeAttribute("hidden");
    document.getElementById("topnav-signin")?.setAttribute("hidden", "");
    const avatarInitial = document.getElementById("topnav-avatar-initial");
    if (avatarInitial) {
      const source = user.name?.trim() || user.email?.trim() || "";
      // Code-point split — `source[0]` would render half a surrogate pair.
      avatarInitial.textContent = source ? [...source][0].toUpperCase() : "?";
    }
  })();
</script>
