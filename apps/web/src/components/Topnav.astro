---
// Top navigation. One reveal mechanic — the auth-aware swap:
// `/api/auth/get-session` probe runs on every page load; when it
// resolves authed, the "Sign in" link is hidden and an avatar button
// takes its place, opening a dropdown with Open chat / API keys /
// Billing / Sign out.
//
// Marketing-side caveat (`SK-WEB-009`): probe returns null on
// `nlqdb.com` because the session cookie is host-only on
// `app.nlqdb.com` — authed visitors see the "Sign in" link.
import { appHref } from "../lib/app-href";

interface Props {
  current?:
    | "manifesto"
    | "agents"
    | "chat"
    | "keys"
    | "billing"
    | "vs"
    | "solve"
    | "blog"
    | "pricing";
}
const { current } = Astro.props;
const inChat = current === "chat";
---

<header class="topnav">
  <a class="topnav__brand" href="/">nlqdb</a>
  <nav class="topnav__links" aria-label="Primary">
    <a
      href="/manifesto/"
      aria-current={current === "manifesto" ? "page" : undefined}
    >
      Manifesto
    </a>
    <a
      href="/agents/"
      aria-current={current === "agents" ? "page" : undefined}
    >
      Agents
    </a>
    <a
      href="/vs/"
      aria-current={current === "vs" ? "page" : undefined}
    >
      Compare
    </a>
    <a
      href="/solve/"
      aria-current={current === "solve" ? "page" : undefined}
    >
      Solve
    </a>
    <a
      href="/blog/"
      aria-current={current === "blog" ? "page" : undefined}
    >
      Blog
    </a>
    <a
      href="/pricing/"
      aria-current={current === "pricing" ? "page" : undefined}
    >
      Pricing
    </a>
    <a href="mailto:hello@nlqdb.com">Contact</a>

    {/* Sign-in link — suppressed once the auth probe resolves authed. */}
    <span id="topnav-signin">
      <a href="/auth/sign-in/">Sign in</a>
    </span>

    {/* Authed slot — hidden by default; revealed only after the
        probe resolves authed. Replaces the sign-in link. Everything
        that used to be four flat links/buttons (Open chat, API keys,
        Billing, Sign out) now lives behind one avatar button so the
        row doesn't outgrow narrow viewports. The "Open chat" item is
        suppressed when the visitor is already inside the chat
        (current === "chat") — no reason to offer a jump to the page
        they're on. */}
    <span id="topnav-authed" class="topnav__authed" hidden>
      <div class="topnav__avatar-wrap">
        <button
          type="button"
          id="topnav-avatar-btn"
          class="topnav__avatar"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-label="Account menu"
        >
          <span id="topnav-avatar-initial" aria-hidden="true">·</span>
        </button>
        <div id="topnav-avatar-panel" class="topnav__avatar-panel" role="menu" hidden>
          {!inChat && (
            <a href={appHref("/app/")} class="topnav__avatar-item" role="menuitem">
              Open chat &rarr;
            </a>
          )}
          <a
            href={appHref("/app/keys/")}
            class="topnav__avatar-item"
            role="menuitem"
            aria-current={current === "keys" ? "page" : undefined}
          >
            API keys
          </a>
          <a
            href={appHref("/app/billing/")}
            class="topnav__avatar-item"
            role="menuitem"
            aria-current={current === "billing" ? "page" : undefined}
          >
            Billing
          </a>
          <button
            type="button"
            id="topnav-signout"
            class="topnav__avatar-item topnav__avatar-item--signout"
            role="menuitem"
          >
            Sign out
          </button>
        </div>
      </div>
    </span>
  </nav>
</header>

<script>
  import { fetchSession } from "../lib/session";

  // The "Sign in" link stays a relative path on every origin. On the
  // marketing origin, `/auth/sign-in` itself hops to the merged app
  // worker (SK-AUTH-015 / SK-AUTH-016) carrying the visitor's draft /
  // pending prompt / anon token in the URL fragment (SK-ANON-015) —
  // a direct cross-origin href here would strand that localStorage
  // state on `nlqdb.com`.

  // ---- Auth-aware swap ---------------------------------------------
  const signinSlot = document.getElementById("topnav-signin");
  const authed = document.getElementById("topnav-authed");
  const signoutBtn = document.getElementById("topnav-signout");
  const avatarBtn = document.getElementById("topnav-avatar-btn");
  const avatarInitial = document.getElementById("topnav-avatar-initial");
  const avatarPanel = document.getElementById("topnav-avatar-panel");

  if (signoutBtn) {
    // All sign-out triggers funnel through /auth/sign-out (SK-AUTH-019).
    signoutBtn.addEventListener("click", () => {
      window.location.assign("/auth/sign-out/");
    });
  }

  // ---- Avatar dropdown -----------------------------------------------
  // Replaces the four flat authed items with one button + popover
  // (APG menu-button pattern): click/Escape/outside-click all close it.
  function closeAvatarPanel() {
    if (!avatarPanel || !avatarBtn) return;
    avatarPanel.hidden = true;
    avatarBtn.setAttribute("aria-expanded", "false");
  }

  if (avatarBtn && avatarPanel) {
    avatarBtn.addEventListener("click", () => {
      const opening = avatarPanel.hidden;
      avatarPanel.hidden = !opening;
      avatarBtn.setAttribute("aria-expanded", String(opening));
    });
    document.addEventListener("click", (event) => {
      if (avatarPanel.hidden) return;
      const target = event.target as Node;
      if (avatarBtn.contains(target) || avatarPanel.contains(target)) return;
      closeAvatarPanel();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAvatarPanel();
    });
  }

  void (async () => {
    const user = await fetchSession();
    if (!user) return;
    if (authed) authed.hidden = false;
    if (signinSlot) signinSlot.setAttribute("hidden", "");
    if (avatarInitial) {
      const source = user.name?.trim() || user.email?.trim() || "";
      avatarInitial.textContent = source ? source[0].toUpperCase() : "?";
    }
  })();
</script>
