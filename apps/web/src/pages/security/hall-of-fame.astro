---
// Security Hall of Fame — advertised by SECURITY.md and
// /.well-known/security.txt (RFC 9116 Acknowledgments), so this URL must
// exist (claim-integrity, scorecard row #19). Ported from the retired
// apps/coming-soon stub.
// Carries the site chrome like every other sitemap-advertised page, so an
// organic arrival can navigate onward — pinned by `__tests__/sitemap.xml.test.ts`.
import Footer from "../../components/Footer.astro";
import Topnav from "../../components/Topnav.astro";
import Base from "../../layouts/Base.astro";
import { appHref } from "../../lib/app-href";
---
<Base
  title="Security Hall of Fame — nlqdb"
  description="Researchers who have responsibly disclosed security issues to nlqdb."
  canonical="/security/hall-of-fame"
>
  <div class="page">
    <Topnav />

    <main class="hof">
      <h1>Security Hall of Fame</h1>

      <p>
        Thanks to the researchers below for responsibly disclosing security
        issues to nlqdb. Listing here is opt-in — we ask before adding anyone,
        and we use only the name or handle the researcher chooses.
      </p>

      <p>
        Want to report something? Email
        <a href="mailto:security@nlqdb.com">security@nlqdb.com</a>. We
        acknowledge within 72 hours, fix confirmed issues within 90 days, and
        credit reporters here at their request.
      </p>

      <h2>Researchers</h2>
      <p><em>No reports yet. Be the first.</em></p>

      <p class="hof__note">
        nlqdb is pre-revenue and does not currently operate a paid bug-bounty
        program. We may, at our sole discretion, offer a token of thanks for
        exceptional reports, but credit on this page is the standard
        recognition.
      </p>

      <section class="hof__cta">
        <h2 class="hof__cta-title">New here? nlqdb is a database you query in plain English.</h2>
        <p>No schema wrangling, no SQL — describe what you want and get the answer.</p>
        <a class="cta hof__cta-btn" href={appHref("/app/new/")}>Start with a goal &rarr;</a>
        <p class="hof__cta-meta">
          No sign-in. The anonymous database lasts 72 hours; adopt it with one
          click if you keep it.
        </p>
      </section>
    </main>

    <Footer />
  </div>
</Base>

<style>
  /* Horizontal padding comes from `.page`; this sets the reading measure only. */
  .hof {
    max-width: 42rem;
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }
  .hof h1 {
    margin-bottom: 1.5rem;
  }
  .hof h2 {
    margin-top: 2.5rem;
  }
  .hof p {
    margin-top: 1rem;
    line-height: 1.6;
  }
  .hof__note {
    margin-top: 3rem;
    font-size: 0.85em;
    opacity: 0.7;
  }
  /* Final CTA — the page's highest-traffic organic surface (row #7); the
     .cta primitive carries the lime moment, matching the /solve idiom. */
  .hof__cta {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .hof__cta-title {
    margin-top: 0;
  }
  .hof__cta-btn {
    margin-top: 1.5rem;
  }
  .hof__cta-meta {
    font-size: 0.85em;
    opacity: 0.7;
  }
</style>
