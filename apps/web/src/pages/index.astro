---
// Homepage — SK-WEB-031 (one-input home, section rhythm) in the SK-WEB-020
// calm token system. Tokens + shared primitives live in global.css; this
// page's layout lives in apps/web/src/styles/home2.css, scoped `.home2`.
//
// Section rhythm (END_GOAL row 9 first, then the DBA loop in order):
//   1. Hero — one promise, ONE input + starter goals (SK-ONBOARD-008), the
//      page's single promoted CTA. Anonymous DB before any sign-in
//      (GLOBAL-007 / SK-ANON-001). Live `/v1/ask`, never canned (SK-WEB-008).
//   2. How it works — infer → evolve → optimize, three steps.
//   3. Diff-then-confirm — the trust moment (SK-TRUST-001 / SK-TRUST-002).
//   4. Surfaces — SDK · element · MCP · CLI, honest status per progress.md §0.
//   5. Ways in — agent memory (SK-WEB-016 <McpInstall>) and BYO warehouse
//      (SK-WEB-019 /app/connect), demoted from doors to a band.
//   6. What is next — non-gating Become AI interest capture.
//   7. Under the hood — poster portal to /architecture/ (SK-WEB-021).
//   8. Closing CTA + the facts we can measure.
// Accent budget (SK-WEB-020): one promoted CTA per band.

import AuthedHomeBanner from "../components/AuthedHomeBanner.astro";
import CreateForm from "../components/CreateForm.tsx";
import Footer from "../components/Footer.astro";
import McpInstall from "../components/McpInstall.astro";
import PivotInterestForm from "../components/PivotInterestForm.astro";
import Topnav from "../components/Topnav.astro";
import Base from "../layouts/Base.astro";
import { appHref } from "../lib/app-href";
import "../styles/home2.css";

// Default to "" (same-origin) — `apps/web` is bundled into the
// `nlqdb-api` Worker's [assets] binding (SK-AUTH-016).
const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---

<Base
  title="nlqdb — your autonomous DBA, no data modeling"
  description="Build a real app with no data modeling. nlqdb infers your schema from how you use it, evolves it, keeps it optimized — and previews every change."
  ogImage="/og/agents.png"
  ogImageAlt="nlqdb — your autonomous DBA."
>
  <div class="page home2">
    <Topnav />

    <main>
      <AuthedHomeBanner />

      {/* ---- 1. Hero: one promise, one input (END_GOAL row 9) ---- */}
      <section class="hero2" aria-labelledby="hero-title">
        <span class="hero2__pill"><span class="dot"></span>Pre-beta · free while we build</span>
        <h1 class="hero2__title" id="hero-title">
          Your autonomous DBA. <em>No data modeling.</em>
        </h1>
        <p class="hero2__say">
          Write rows from day one. nlqdb infers the schema from your inserts, evolves it as your
          app changes, keeps it fast — and shows you every change before it lands.
        </p>

        {/* The one input. Starter chips fill it, never submit (SK-ONBOARD-008);
            the form's own title is visually hidden here because the H1 above
            is the promise. */}
        <div class="hero2__form">
          <CreateForm client:load apiBase={apiBase} headingLevel="h2" />
        </div>
      </section>

      {/* ---- 2. How it works: the DBA loop in three steps ---- */}
      <section class="how" aria-labelledby="how-title">
        <header class="band__head reveal">
          <p class="eyebrow">How it works</p>
          <h2 class="band__title" id="how-title">You write app data. The DBA does the rest.</h2>
        </header>

        <ol class="steps">
          <li class="step reveal">
            <span class="step__num">1</span>
            <h3 class="step__title">Write rows, not DDL</h3>
            <p class="step__body">
              Describe what you're building, then insert like the tables already exist. There is
              no <code>CREATE TABLE</code> to write on any surface.
            </p>
            <pre class="step__code"><code><span class="tk-c">// first write — no schema yet</span>
add an order: 2 lattes, table 4</code></pre>
          </li>
          <li class="step reveal">
            <span class="step__num">2</span>
            <h3 class="step__title">The schema is inferred — and evolves</h3>
            <p class="step__body">
              A field nobody modeled? The preview names the added column and the row lands in the
              same commit. Old queries keep answering.
            </p>
            <pre class="step__code"><code><span class="tk-add">+ table  orders (drink, qty, table_no)</span>
<span class="tk-add">+ column orders.tip numeric</span> <span class="tk-c">← later</span></code></pre>
          </li>
          <li class="step reveal">
            <span class="step__num">3</span>
            <h3 class="step__title">
              It optimizes; you click
              <span class="badge" title="Optimizer proposals ship in the next engine phase">in progress</span>
            </h3>
            <p class="step__body">
              Indexes, retypes, engine moves — each proposal previewed with its expected effect and
              its inverse recorded first. Apply once; undo once.
            </p>
            <pre class="step__code"><code>proposal  index orders(created_at)
effect    "orders today" scans less
<span class="tk-c">[ apply ]  [ undo ]</span></code></pre>
          </li>
        </ol>
      </section>

      {/* ---- 3. Diff-then-confirm: the trust moment (SK-TRUST-001/-002) ---- */}
      <section class="confirm band band--tint" aria-labelledby="confirm-title">
        <div class="confirm__copy reveal">
          <p class="eyebrow">Before anything changes</p>
          <h2 class="band__title" id="confirm-title">Every write shows its diff. You confirm.</h2>
          <p class="band__lede">
            Writes come back as <code>requires_confirm</code> with a diff and the compiled SQL.
            Nothing runs until you say so.
          </p>
          <ul class="ticks">
            <li>One preview, one confirm — no undo needed after a write you approved</li>
            <li>The trace is always attached: cache · plan · validate · exec · summarize</li>
            <li>Reads are validated against a fail-closed allow-list before they run</li>
          </ul>
        </div>

        {/* Representative shape of the preview → confirm exchange. */}
        <figure class="preview reveal" aria-label="Example write preview">
          <div class="preview__ask"><span class="prompt">&rsaquo;</span>add a $2 tip to order 418</div>
          <div class="preview__diff">
            <span class="preview__tag">requires_confirm</span>
            <dl class="preview__kv">
              <dt>verb</dt><dd>UPDATE</dd>
              <dt>table</dt><dd>orders</dd>
              <dt>rows</dt><dd>1</dd>
              <dt>schema</dt><dd><span class="tk-add">+ column orders.tip numeric</span></dd>
            </dl>
            <pre class="preview__sql"><code>UPDATE orders SET tip = 2.00 WHERE id = 418;</code></pre>
          </div>
          <div class="preview__actions" aria-hidden="true">
            <span class="cta cta--ghost preview__btn">Confirm</span>
            <span class="preview__trace">cache · plan · validate <span class="ms">waiting for you</span></span>
          </div>
          <figcaption class="preview__cap">
            A representative preview — the diff names the row effect and any column the write adds.
          </figcaption>
        </figure>
      </section>

      {/* ---- 4. Surfaces: one engine, four doors into it (progress.md §0) ---- */}
      <section class="surfaces" aria-labelledby="surfaces-title">
        <header class="band__head reveal">
          <p class="eyebrow">One engine, every surface</p>
          <h2 class="band__title" id="surfaces-title">Use it from wherever you build.</h2>
        </header>
        <ul class="tiles">
          <li class="tile reveal">
            <span class="tile__kind">SDK</span>
            <code class="tile__code">npm i @nlqdb/sdk</code>
            <p class="tile__body">The only HTTP client — create, ask, run, stream.</p>
            <a class="tile__link" href="/integrations/">Integrate &rarr;</a>
          </li>
          <li class="tile reveal">
            <span class="tile__kind">Element</span>
            <code class="tile__code">&lt;nlq-data goal="orders today"&gt;</code>
            <p class="tile__body">One tag answers a question inline on any page.</p>
            <a class="tile__link" href="/integrations/">Embed &rarr;</a>
          </li>
          <li class="tile reveal">
            <span class="tile__kind">MCP</span>
            <code class="tile__code">mcp.nlqdb.com/mcp</code>
            <p class="tile__body">Your agent writes and queries its own database.</p>
            <a class="tile__link" href="/agents/">For agents &rarr;</a>
          </li>
          <li class="tile reveal">
            <span class="tile__kind">CLI <span class="badge">phase 2</span></span>
            <code class="tile__code">nlq ask "orders today"</code>
            <p class="tile__body">Same engine from the terminal; bootstrap landed.</p>
            <a class="tile__link" href="/integrations/">Install &rarr;</a>
          </li>
        </ul>
      </section>

      {/* ---- 5. Ways in: agent memory + BYO warehouse (demoted doors) ---- */}
      <section class="ways band" aria-labelledby="ways-title">
        <header class="band__head reveal">
          <p class="eyebrow">Also a fit if</p>
          <h2 class="band__title" id="ways-title">Your agent needs memory, or your data already lives somewhere.</h2>
        </header>
        <div class="ways__grid">
          <article class="way reveal" aria-labelledby="way-a-title">
            <h3 class="way__title" id="way-a-title">Use it as agent memory</h3>
            <p class="way__lede">
              A real Postgres your agent writes to as it learns — typed rows, queried in English,
              installed in your host over MCP.
            </p>
            <McpInstall compact={true} />
          </article>
          <article class="way reveal" aria-labelledby="way-b-title">
            <h3 class="way__title" id="way-b-title">Question the warehouse you already run</h3>
            <p class="way__lede">
              Point nlqdb at your ClickHouse or Postgres with a read-only connection. It reads the
              schema; you ask in English.
            </p>
            <p class="secure">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="11" width="16" height="9" rx="2"></rect>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
              </svg>
              <span><strong>Sealed server-side</strong> — the connection string is never stored in your browser.</span>
            </p>
            <a class="cta cta--ghost way__cta" href="/auth/sign-in/?return_to=/app/connect/">
              Connect a warehouse &rarr;
            </a>
            <p class="way__quiet">Sign in (always free), then connect read-only.</p>
          </article>
        </div>
      </section>

      {/* The current product stays open; this is an interest signal for the
          next product, after visitors have seen the working engine. */}
      <section
        class="future band band--tint reveal"
        id="become-ai"
        aria-labelledby="future-title"
      >
        <div class="future__copy">
          <p class="eyebrow">What we&rsquo;re building next</p>
          <h2 class="band__title" id="future-title">
            AI can&rsquo;t replace you if you become AI.
          </h2>
          <p class="band__lede">
            Turn what you know into a structured knowledge product agents can query — and earn
            when they use it. The first pilot is for language tutors.
          </p>
          <a class="future__link" href="/experts/">See how Become AI will work &rarr;</a>
        </div>
        <div class="future__signup">
          <p class="future__promise">
            Look forward to a guided expertise interview, a knowledge base you can inspect and
            correct, and marketplace access you control.
          </p>
          <PivotInterestForm source="home" />
        </div>
      </section>

      {/* ---- 7. Under the hood — poster portal to the 3D map (SK-WEB-021) ---- */}
      <section class="undermap reveal" aria-labelledby="undermap-title">
        <a class="undermap__link" href="/architecture/">
          <img
            class="undermap__img"
            src="/architecture-poster.webp"
            width="2172"
            height="1362"
            loading="lazy"
            decoding="async"
            alt="A 3D map of the nlqdb engine: three lit zones — you ask, the engine, your data — connected by flowing jade request paths."
          />
          <span class="undermap__copy">
            <span class="eyebrow">Under the hood</span>
            <h2 class="undermap__title" id="undermap-title">One engine, seen from above.</h2>
            <span class="undermap__lede">
              Fly through the request path — five surfaces, one engine, your data — and click
              every moving piece.
            </span>
            <span class="undermap__cta">Explore the 3D map &rarr;</span>
          </span>
        </a>
      </section>

      {/* ---- 8. Close: one CTA + the facts we can measure ---- */}
      <section class="close band band--accent reveal" aria-labelledby="close-title">
        <h2 class="band__title" id="close-title">Describe what you're building.</h2>
        <p class="band__lede">
          One sentence gets you a working database — no account, no card, no config. Sign in
          later to keep it and its history.
        </p>
        <a class="cta" href={appHref("/app/new/")}>Describe your data &rarr;</a>
        <ul class="facts" aria-label="Measured facts">
          <li><strong>16.4 ms</strong> p50 on cache hits <span>measured 2026-07-27</span></li>
          <li><strong>$0</strong> free tier <span>no card, ever</span></li>
          <li><strong>0 %</strong> markup <span>on your own LLM key</span></li>
          <li><strong>Every write</strong> previewed <span>diff before commit</span></li>
        </ul>
      </section>
    </main>

    <Footer />
  </div>
</Base>

<script>
  // Provision the anonymous-mode token on first visit (SK-ANON-001) — the
  // hero's create call needs it, and it carries over to /app/new.
  import { getOrMintAnonToken } from "../lib/anon";
  getOrMintAnonToken();
</script>

{/* Reveal-on-scroll — progressive enhancement (SK-WEB-001). Content is
    visible by default; this arms the hidden→reveal transition only when
    JS runs AND motion is allowed. No JS / reduced-motion → everything
    stays visible, no transition. Compositor-free, tiny, no island. */}
<script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var page = document.querySelector(".home2");
    if (!page || !("IntersectionObserver" in window)) return;
    page.classList.add("motion");
    var io = new IntersectionObserver(
      function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            entries[i].target.classList.add("is-in");
            io.unobserve(entries[i].target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
    );
    var nodes = page.querySelectorAll(".reveal");
    for (var i = 0; i < nodes.length; i++) io.observe(nodes[i]);
  })();
</script>
