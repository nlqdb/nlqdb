---
import Base from "../../layouts/Base.astro";

// Magic-link continue page. The API rewrites every magic-link email
// from `app.nlqdb.com/api/auth/magic-link/verify?token=…` to
// `/auth/continue?next=<encoded verify URL>` so passive link-scanners
// (Outlook SafeLinks, Gmail prefetch, Defender) GET the continue page
// — which renders a button — instead of GETting the verify endpoint,
// which would consume the single-use token.
//
// This site builds static (SK-WEB-001, no adapter), so the query
// string exists only in the browser — `next` MUST be resolved in the
// client script below, never in this frontmatter (which runs once at
// build time with an empty query string and would bake one branch
// into the HTML for every visitor). Both cards ship hidden; the
// script reveals exactly one.
//
// Open-redirect defense:
//   `next` is validated against an allow-list of origins before the
//   button gets an href. Anything outside the allow-list is refused —
//   without this, a fake email of the form
//   `https://app.nlqdb.com/auth/continue?next=https://attacker.example/`
//   would phish through our own domain. The verify URL itself is
//   protected by Better Auth's single-use token; the allow-list only
//   needs to ensure `next` points at OUR verify endpoint.
---

<Base
  title="Sign in — nlqdb"
  description="Confirm your magic-link sign-in to nlqdb."
  canonical="/auth/continue"
  noindex
>
  <div class="page">
    <main class="auth-continue">
      <section
        id="continue-card"
        class="auth-continue__card"
        aria-labelledby="continue-title"
        hidden
      >
        <h1 id="continue-title" class="auth-continue__title">
          Sign in to nlqdb
        </h1>
        <p class="auth-continue__lede">
          Click below to finish signing in. The link is single-use and
          expires in 10 minutes.
        </p>
        <p class="auth-continue__cta">
          <a id="continue-link" class="btn btn--accent" rel="noopener">
            Continue to nlqdb
          </a>
        </p>
        <p class="auth-continue__hint">
          You&rsquo;re seeing this page because email security
          scanners sometimes follow links automatically. The button
          keeps your one-time link valid until you click it.
        </p>
      </section>

      <section
        id="continue-error"
        class="auth-continue__card auth-continue__card--err"
        aria-labelledby="continue-error-title"
        hidden
      >
        <h1 id="continue-error-title" class="auth-continue__title">
          This link can&rsquo;t be opened.
        </h1>
        <p id="continue-error-lede" class="auth-continue__lede">
          The sign-in link is missing or malformed.
        </p>
        <p class="auth-continue__hint">
          Try requesting a fresh link from the sign-in page.
        </p>
        <p class="auth-continue__cta">
          <a class="btn btn--accent" href="/">Back to home</a>
        </p>
      </section>
    </main>
  </div>
</Base>

<script>
  // `location.origin` covers the merged worker (SK-AUTH-016) wherever
  // it's served — prod, canary (`BETTER_AUTH_URL`), previews; the
  // literals keep the prod verify origin and `wrangler dev` working
  // when the page is served from a different origin (`astro dev`).
  const ALLOWED_NEXT_ORIGINS = new Set([
    location.origin,
    "https://app.nlqdb.com",
    "http://localhost:8787",
  ]);

  function resolveNext(raw: string | null): { url: string } | { error: string } {
    if (!raw) return { error: "The sign-in link is missing or malformed." };
    let parsed: URL;
    try {
      parsed = new URL(raw);
    } catch {
      return { error: "The sign-in link is missing or malformed." };
    }
    if (!ALLOWED_NEXT_ORIGINS.has(parsed.origin)) {
      return {
        error:
          "The destination of this link isn't an nlqdb endpoint, so we won't forward you to it.",
      };
    }
    return { url: parsed.toString() };
  }

  const resolved = resolveNext(new URLSearchParams(location.search).get("next"));
  if ("url" in resolved) {
    const link = document.getElementById("continue-link") as HTMLAnchorElement | null;
    if (link) link.href = resolved.url;
    document.getElementById("continue-card")?.removeAttribute("hidden");
  } else {
    const lede = document.getElementById("continue-error-lede");
    if (lede) lede.textContent = resolved.error;
    document.getElementById("continue-error")?.removeAttribute("hidden");
  }
</script>

<style is:global>
  .auth-continue {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: clamp(48px, 8vw, 96px) 24px;
  }

  .auth-continue__card {
    border: 1px solid var(--rule-2);
    border-radius: var(--r-lg);
    background: var(--raised);
    padding: clamp(28px, 5vw, 48px);
    max-width: 520px;
    width: 100%;
    box-shadow: var(--shadow-3);
  }

  .auth-continue__card--err {
    border-color: var(--rule-2);
  }

  .auth-continue__title {
    font-family: var(--sans);
    font-size: clamp(22px, 3.2vw, 28px);
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .auth-continue__lede {
    margin: 0 0 20px;
    font-size: clamp(15px, 1.6vw, 16px);
    color: var(--ink);
    line-height: 1.5;
  }

  .auth-continue__cta {
    margin: 0 0 20px;
  }

  .auth-continue__hint {
    margin: 0;
    font-size: 13px;
    color: var(--body);
    line-height: 1.5;
  }
</style>
