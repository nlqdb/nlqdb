---
// `/app/dba` v0 (GLOBAL-041 step 11, END_GOAL row 4): every schema change the
// DBA made on a database, newest first, each with its inverse. Reads
// `GET /v1/databases/:id/changes`; proposals and apply/undo come in Phase B.

import AppAnalytics from "../../components/AppAnalytics.astro";
import ConsentBanner from "../../components/ConsentBanner.astro";
import DbaPanel from "../../components/dba/DbaPanel.tsx";
import Footer from "../../components/Footer.astro";
import SupportChat from "../../components/SupportChat.astro";
import Topnav from "../../components/Topnav.astro";
import Base from "../../layouts/Base.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---
<Base
  title="Schema changes — nlqdb"
  description="Every schema change the DBA made on your database, with its undo statement."
  noindex
>
  <div class="page page--keys" id="dba-shell" data-api-base={apiBase} hidden>
    <Topnav current="dba" />
    <main class="page__main page__main--keys">
      <DbaPanel client:only="react" apiBase={apiBase} />
    </main>
    <Footer />
  </div>
  <AppAnalytics />
  <ConsentBanner />
  <SupportChat />
</Base>

<script>
  // Inline auth guard — mirrors `/app/index.astro` (SK-AUTH-016 /
  // SK-WEB-009). The shell stays `hidden` until `fetchSession`
  // resolves; an unauthenticated probe redirects to sign-in with a
  // `return_to` so post-signin lands back here.
  import { fetchSession, invalidateSession } from "../../lib/session";

  const shell = document.getElementById("dba-shell");
  if (shell) {
    const apiBase = (shell as HTMLElement).dataset["apiBase"];

    async function requireSession(): Promise<boolean> {
      const user = await fetchSession(apiBase);
      if (!user) {
        const returnTo = `${location.pathname}${location.search}${location.hash}`;
        const signInUrl = new URL("/auth/sign-in/", location.origin);
        signInUrl.searchParams.set("return_to", returnTo);
        location.replace(signInUrl.toString());
        return false;
      }
      return true;
    }

    // WS02-T2: re-probe on bfcache restore so a signed-out cookie can't
    // leave the shell visible (mirrors /app/index.astro).
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) {
        invalidateSession();
        void requireSession();
      }
    });

    void (async () => {
      if (!(await requireSession())) return;
      shell.hidden = false;
    })();
  }
</script>

<style is:global>
  @import "../../styles/keys.css";
  @import "../../styles/dba.css";
</style>
