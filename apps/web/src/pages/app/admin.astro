---
// Founder GTM/PMF dashboard (SK-GTM-004, GLOBAL-038). The only gate is
// the SK-GTM-002 server one on `GET /v1/admin/metrics`: this page's
// script decides sign-in only, and a signed-in non-admin reads the 403
// as a named in-page state (GLOBAL-012) instead of being bounced.

import AppAnalytics from "../../components/AppAnalytics.astro";
import AdminDashboard from "../../components/admin/AdminDashboard.tsx";
import ConsentBanner from "../../components/ConsentBanner.astro";
import Footer from "../../components/Footer.astro";
import SupportChat from "../../components/SupportChat.astro";
import Topnav from "../../components/Topnav.astro";
import Base from "../../layouts/Base.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "";
---
<Base
  title="Admin — GTM/PMF — nlqdb"
  description="Founder dashboard: acquisition funnel, activation, retention, PMF signals."
>
  <div class="page page--admin" id="admin-shell" data-api-base={apiBase} hidden>
    {/* No `current` — this page is not the chat, so the topnav's
        one-click "Open chat" link must stay offered (P6). */}
    <Topnav />
    <main class="page__main page__main--admin">
      <AdminDashboard client:only="react" apiBase={apiBase} />
    </main>
    <Footer />
  </div>
  <AppAnalytics />
  <ConsentBanner />
  <SupportChat />
</Base>

<script>
  // Inline auth guard — the keys.astro pattern, sign-in only. The
  // admin predicate is not repeated here (SK-GTM-002): a signed-in
  // non-admin gets the island's named 403 state, never a silent bounce
  // to /app/ (which auto-pins a DB and reads as "the page moved").
  import { fetchSession, invalidateSession } from "../../lib/session";

  const shell = document.getElementById("admin-shell");
  if (shell) {
    const apiBase = (shell as HTMLElement).dataset["apiBase"];

    async function requireSignedIn(): Promise<boolean> {
      const user = await fetchSession(apiBase);
      if (user) return true;
      const returnTo = `${location.pathname}${location.search}${location.hash}`;
      const signInUrl = new URL("/auth/sign-in/", location.origin);
      signInUrl.searchParams.set("return_to", returnTo);
      location.replace(signInUrl.toString());
      return false;
    }

    // Re-probe on bfcache restore so a signed-out cookie can't leave
    // the admin shell visible (mirrors /app/keys.astro).
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) {
        invalidateSession();
        void requireSignedIn();
      }
    });

    void (async () => {
      if (!(await requireSignedIn())) return;
      shell.hidden = false;
    })();
  }
</script>

<style is:global>
  @import "../../styles/admin.css";
</style>
