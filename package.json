{
  "name": "nlqdb",
  "private": true,
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "description": "Analytical memory for AI agents — a real database your agent queries over MCP in English (GROUP BY, JOIN, aggregate), not just recall. Also a natural-language database for any app.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "fix": "biome check --write",
    "check:go": "gofumpt -l cli && go -C cli vet ./... && cd cli && golangci-lint run ./...",
    "check:py": "ruff check && ruff format --check",
    "check:all": "bun run check && bun run check:go && bun run check:py",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-source-versions.mjs && node scripts/sync-readme-packages.mjs && bun install --lockfile-only",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "~1.64.1",
    "bun-types": "latest",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "hono": "^4.12.25",
    "shell-quote": "^1.12.0",
    "qs": "^6.16.1",
    "postcss": "^8.5.32",
    "fast-uri": "^3.1.9",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "esbuild": "^0.28.1",
    "@hono/node-server": "^2.1.3",
    "dompurify": "^3.4.17",
    "proxy-addr": "^2.0.8"
  }
}
