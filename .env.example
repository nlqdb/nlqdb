# nlqdb — environment variables
#
# Per DESIGN.md §2.7 this file lists variable NAMES only. Never commit real
# values. Local dev copies this to .envrc (gitignored); CI uses GitHub Actions
# secrets; runtime uses Cloudflare Workers secrets.
#
# Generate real values via: scripts/bootstrap-dev.sh
# Sign in to cloud providers via: scripts/login-cloud.sh

# --- Self-generated (bootstrap-dev.sh) ------------------------------------
BETTER_AUTH_SECRET=
# Dedicated API-key HMAC secret (SK-APIKEYS-014). Optional — code falls back
# to BETTER_AUTH_SECRET when unset. Seed it to the current BETTER_AUTH_SECRET
# value for a zero-rehash migration, then rotate either secret independently.
API_KEY_SECRET=
INTERNAL_JWT_SECRET=
# BYO-connect envelope key-encryption key (GLOBAL-031). Seals each BYO
# database URL at rest (AES-256-GCM). Generate: openssl rand -base64 32.
# Runtime Worker secret — unset ⇒ POST /v1/db/connect 503s sealing_unconfigured.
BYO_SECRET_KEK=

# --- Cloudflare (§2.3) ---------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_AI_TOKEN=
# Turnstile-write-scoped CF API token (Account → Turnstile → Edit). Lets an
# agent/workflow create the widget via POST accounts/{id}/challenges/widgets;
# the main CLOUDFLARE_API_TOKEN only has read. Unset ⇒ make the widget in the console.
CF_TURNSTILE_EDIT_API_TOKEN=

# --- Data plane (§2.3) ---------------------------------------------------
# NEON_API_KEY is the Neon *control-plane* API key (mint / list / delete
# projects, branches, databases). DATABASE_URL is the per-project
# Postgres connection string for the current env's main branch.
# Never commit real values. Rotate immediately if either leaks.
NEON_API_KEY=
DATABASE_URL=
FLY_API_TOKEN=

# --- LLM providers (§2.4) ------------------------------------------------
# CEREBRAS_API_KEY leads the planner tier (gpt-oss-120b) per SK-LLM-023.
CEREBRAS_API_KEY=
# MISTRAL_API_KEY is the planner-tier capacity backstop at the chain tail per SK-LLM-028.
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Paid frontier eval lane (tools/eval only; never a Worker secret) for the
# free-vs-frontier delta — the GLOBAL-025 headline KPI. Kept a distinct name
# so a fork PR can never pull a paid key; the mirror defaults it to
# OPENROUTER_API_KEY when unset, so one paid OpenRouter account serves both.
OPENROUTER_FRONTIER_API_KEY=
# SambaNova Cloud (OpenAI-compatible, https://api.sambanova.ai/v1) — arms the
# 3rd opencheck agent lane (_e2e-opencheck.yml, secrets.FALLBACK2_LLM_API_KEY).
# CI-only, never a Worker secret. Unset ⇒ that lane degrades to disabled.
FALLBACK2_LLM_API_KEY=
# CF Workers AI is covered by CF_AI_TOKEN above.
# Ollama runs locally, no token required.

# --- OAuth (§2.5) --------------------------------------------------------
# GitHub OAuth uses the `OAUTH_GITHUB_*` prefix because GitHub Actions
# reserves the `GITHUB_*` namespace for built-ins (GITHUB_TOKEN etc.) —
# repo/org secrets prefixed with `GITHUB_` are rejected. Local names
# match CI / Workers names so secret-mirroring is 1:1.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Dev OAuth App (`nlqdb-web-dev`) — separate App because GitHub OAuth
# Apps support exactly one callback URL each; dev uses
# http://localhost:8787/api/auth/callback/github.
OAUTH_GITHUB_CLIENT_ID_DEV=
OAUTH_GITHUB_CLIENT_SECRET_DEV=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# BYO-connect Supabase OAuth app (SK-DBCONN-003, PR #981). Provisioned ahead of
# the connect-routes build so it's not a blocker later; mirrored to GHA only for
# now — promoted to the api Worker subset when the routes that read it ship.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# Founder-side names for the canary OAuth pairs (SK-AUTH-008 / SK-AUTH-017).
# The CANARY_ prefix only distinguishes the pairs in this one .envrc; the
# canary Worker stores them under the prod-slot names. Mirrored to the
# canary Worker by scripts/mirror-secrets-canary.sh — NOT to GHA (no CI
# consumer). GitHub halves stay empty until the canary GitHub App is registered.
CANARY_GOOGLE_CLIENT_ID=
CANARY_GOOGLE_CLIENT_SECRET=
CANARY_OAUTH_GITHUB_CLIENT_ID=
CANARY_OAUTH_GITHUB_CLIENT_SECRET=

# --- GitHub API (§2 ICP evidence writer) --------------------------------
# Fine-grained PAT used by the ICP cron for Issues search + Contents API
# evidence writes. Do not use the reserved GitHub Actions GITHUB_TOKEN name.
GH_TOKEN=

# --- Email (§2.5) --------------------------------------------------------
RESEND_API_KEY=
# AWS SES fallback was evaluated 2026-04-25 and skipped — card-required,
# and Resend's free tier (3k/mo) covers pre-PMF traffic. If a fallback
# becomes necessary, prefer Postmark / MailerSend / Loops over AWS SES.

# --- Payments (§2.5) — Stripe (going live; see stripe-billing/FEATURE.md) --
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout plan price IDs — apps/api reads these at runtime; unset ⇒
# /v1/billing/checkout 503s plan_not_configured.
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
# Hosted-premium metered overage (SK-PREMIUM-009). Both emitted by
# apps/api/scripts/stripe-premium-bootstrap.ts; unset ⇒ overage is
# ledgered in D1 but not attached to a Stripe item (fails safe).
STRIPE_PRICE_OVERAGE_ANTHROPIC=
STRIPE_PREMIUM_METER_ID=

# --- Hosted-premium LLM lane (§6) — premium-tier/FEATURE.md ---------------
# Dark until the platform key + AI Gateway ids below are set AND the flip is
# on. `premiumConfigured` (billing/premium/index.ts) requires ALL of:
# PREMIUM_ANTHROPIC_API_KEY, AI_GATEWAY_ACCOUNT_ID, AI_GATEWAY_ID,
# PREMIUM_METER_LIVE. Provably no-op while unset — /v1/ask never routes to
# premium (GLOBAL-026).
PREMIUM_ANTHROPIC_API_KEY=
# Cloudflare AI Gateway the premium lane routes through. ACCOUNT_ID == your
# CLOUDFLARE_ACCOUNT_ID; ID is the gateway slug (Cloudflare → AI → AI Gateway).
AI_GATEWAY_ACCOUNT_ID=
AI_GATEWAY_ID=
# Gateway auth token — REQUIRED when the gateway has "Authenticated Gateway"
# on. Sent as `cf-aig-authorization` on every gateway-routed LLM call (free
# chain + BYOLLM + premium). Create under AI Gateway → your gateway → Settings
# → Authenticated Gateway (permission: AI Gateway → Run). Unset ⇒ no header; if
# the gateway then requires auth, every /v1/ask 502s (SK-LLM-046).
AI_GATEWAY_TOKEN=
# The go-live flip (truthy enables). The secret-mirror rejects values
# under 4 chars, so set it to `true` (not `1`).
PREMIUM_METER_LIVE=

# --- Observability (§2.6) ------------------------------------------------
SENTRY_DSN=
# Grafana Cloud authenticates OTLP pushes via Basic auth where the
# username is the numeric stack instance ID and the password is an
# access policy token. Both are separate for rotation independence.
GRAFANA_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=
# Plausible is self-hosted on Fly (§2.6) — no SaaS key.

# --- Product events (§2.6) -----------------------------------------------
# LogSnag — single sink for founder pings + queryable event history
# (signup / first-query / subscription lifecycle). LogSnag forwards to
# Slack/Discord/email itself, so we don't need a separate channel.
# Free tier (Apr 2026): 2,500 events/mo — only fire one-shot events,
# never per-sign-in. LOGSNAG_PROJECT is the project slug under our
# account. If LOGSNAG_TOKEN is absent at runtime, packages/events
# drops events for this sink (verified by unit test).
LOGSNAG_TOKEN=
LOGSNAG_PROJECT=
# quality-eval-*.yml bearer for POST /v1/events/eval (mirror of the
# Worker-side EVAL_INGEST_TOKEN secret). Absent ⇒ a full eval run skips
# the feature.eval.* emit but still produces its report artifact.
EVAL_INGEST_TOKEN=
# Tinybird — events-worker writes raw events; workload analyser reads aggregates.
# TINYBIRD_API_BASE: regional endpoint, e.g. https://api.us-east.aws.tinybird.co
# TINYBIRD_TOKEN: static ADMIN token named nlqdb-events-worker (created via tb --cloud token create static)
TINYBIRD_TOKEN=
TINYBIRD_API_BASE=
# PostHog Cloud — DEFERRED / NOT WIRED (SK-EVENTS-007). Empty here is
# correct, not missing. Phase 2 only: an optional second events sink for
# funnels + retention IF SQL on D1/Neon stops being enough. Server-side capture
# from the Worker via ctx.waitUntil — zero user-facing latency, no
# client SDK on the marketing site. Both empty = sink disabled (the
# default — keep them empty until a real cohort/funnel question lands).
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Support chat (SK-WEB-025) -------------------------------------------
# Tawk.to Secure Mode key (Tawk dashboard → Administration → Property
# Settings → JavaScript API → Secure Mode). /api/tawk/identity HMACs the
# signed-in visitor's email with it so Tawk accepts their name/email on the
# dashboard; without it Tawk shows only an anonymous visitor id. Absent ⇒
# the endpoint omits the hash (graceful, no error).
TAWK_TO_API_KEY=

# --- nlqdb self (dogfood) --------------------------------------------------
# MCP-scoped `sk_mcp_` key (SK-APIKEYS-015) the D-02 docs→memory sync
# workflow reads as secrets.NLQDB_API_KEY. The founder's .envrc holds the
# value as NLQDB_MCP_API_KEY; scripts/mirror-secrets-gha.sh maps it.
NLQDB_API_KEY=
