{
  "name": "@nlqdb/mcp",
  "version": "0.1.1",
  "mcpName": "com.nlqdb/nlqdb",
  "description": "Analytical-memory MCP server for nlqdb — a real database your AI agent can GROUP BY / JOIN / aggregate over in natural language, not just recall.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nlqdb/nlqdb.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://nlqdb.com/agents/?utm_source=npm",
  "bugs": "https://github.com/nlqdb/nlqdb/issues",
  "keywords": [
    "nlqdb",
    "mcp",
    "model-context-protocol",
    "agent-memory",
    "ai-agent",
    "memory",
    "postgres",
    "sql",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "nlqdb-mcp": "bin/nlqdb-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target=node --format=esm --outdir=dist --external='@modelcontextprotocol/sdk*' --external=@opentelemetry/api --external=zod --sourcemap=linked --minify",
    "prepack": "node ../../scripts/apply-publish-config.mjs",
    "postpack": "node ../../scripts/apply-publish-config.mjs --restore"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "provenance": true,
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nlqdb/sdk": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
