{
  // Renovate config (replaces ad-hoc version bumps).
  //
  // Default schedule: weekly on Mondays so PR noise lands at the start
  // of the week. Lockfile-only auto-merges; minor/major need review.
  // Coverage is every manifest outside `ignorePaths` below — root
  // workspaces plus the non-workspace suites under `tests/`, which
  // `bun audit` at the root cannot see either.
  // Group rules collapse cross-package bumps (Astro, Hono, Stripe SDK,
  // OpenTelemetry) into single PRs to cut churn.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "schedule:weekly",
    "group:monorepos",
    "group:recommended",
  ],
  // `config:recommended` pulls in `:ignoreModulesAndTests`, whose
  // `ignorePaths` includes `**/tests/**` — so Renovate silently skipped
  // all five manifests under `tests/` (the three e2e bun suites,
  // opencheck, and the Go CLI suite), for upgrades *and* for
  // `vulnerabilityAlerts`: an alert only ever becomes a PR by matching a
  // dependency that extraction already found, and extraction is where
  // `ignorePaths` is applied. They are CI infrastructure, not fixtures,
  // and 19 advisories had piled up in `tests/e2e/mcp` alone before
  // anything flagged them. Restated below without the preset's
  // `tests`/`test`/`__tests__`/`examples` entries — dropping `examples`
  // is safe because those scaffolds carry no manifests at all.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__fixtures__/**",
  ],
  timezone: "Europe/Zurich",
  prHourlyLimit: 4,
  prConcurrentLimit: 8,
  rangeStrategy: "bump",
  rebaseWhen: "auto",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ["before 5am on Monday"],
  },
  packageRules: [
    {
      matchUpdateTypes: ["patch", "pin", "digest"],
      automerge: true,
    },
    {
      matchPackageNames: ["@cloudflare/workers-types", "wrangler", "@cloudflare/vitest-pool-workers"],
      groupName: "cloudflare-tooling",
    },
    {
      // `matchPackagePatterns` was deprecated in Renovate v37; the
      // glob form on `matchPackageNames` is the supported equivalent.
      // Use a single `*` (minimatch — matches one path segment, which
      // is the entire package-name suffix after the org prefix) per
      // the documented form. `**` works in minimatch too but isn't
      // the documented spelling and risks a future tightening.
      matchPackageNames: ["@opentelemetry/*"],
      groupName: "opentelemetry",
    },
    {
      matchPackageNames: ["astro", "@astrojs/*"],
      groupName: "astro",
    },
    {
      matchPackageNames: ["stripe"],
      // Stripe SDK majors track API versions; require manual review.
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      matchManagers: ["github-actions"],
      pinDigests: true,
      groupName: "github-actions",
    },
    {
      // Last, so it overrides the patch/pin/digest automerge above. PR CI
      // only *typechecks* the suites under `tests/` (`typecheck-e2e`); the
      // vitest runs are `workflow_dispatch`-only, so nothing would catch a
      // bump that breaks a test at runtime rather than at the type level.
      // Raise the PR — never merge it unreviewed.
      matchFileNames: ["tests/**"],
      automerge: false,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
    automerge: false,
  },
}
